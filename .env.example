# Copy to .env and load it with:  set -a; source .env; set +a
# Free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key
# Optional: any model listed at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
# Optional: embedding model used to pick the table (default BAAI/bge-m3, ~2.3 GB download)
# EMBED_MODEL=intfloat/multilingual-e5-small
